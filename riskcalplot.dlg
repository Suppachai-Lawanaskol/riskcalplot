VERSION 13

POSITION . . 600 470

DIALOG main, title("riskcalplot - Risk calibration plot") tabtitle("Main")
BEGIN

    TEXT tx_endpoint 15 15 220 ., ///
        label("Endpoint variable (coded 0/1):")

    VARNAME endpoint 15 35 260 ., ///
        label("Endpoint") ///
        error("Endpoint variable")

    TEXT tx_scores 15 75 300 ., ///
        label("Score variable(s), up to 5:")

    VARLIST scores 15 95 555 ., ///
        label("Score variables") ///
        error("Score variable(s)")

    TEXT tx_model 15 140 230 ., ///
        label("Model(s): logit or log")

    EDIT model 15 160 260 ., ///
        label("Model(s)") ///
        error("Model(s)") ///
        default(logit) ///
        option(model)

    TEXT tx_modelnote 290 160 280 ., ///
        label("One model for all scores, or one per score")

    TEXT tx_marker 15 205 220 ., ///
        label("Marker symbol (optional):")

    EDIT marker 15 225 180 ., ///
        label("Marker") ///
        option(marker)

    TEXT tx_markernote 210 225 360 ., ///
        label("Blank = default markers Oh Dh Th Sh X")

    CHECKBOX noci 15 270 280 ., ///
        label("Suppress confidence intervals") ///
        option(noci)

    CHECKBOX nostat 15 300 280 ., ///
        label("Suppress performance statistics") ///
        option(nostat)

    TEXT tx_level 330 270 130 ., ///
        label("Confidence level:")

    SPINNER level 465 267 80 ., ///
        label("Confidence level") ///
        min(50) ///
        max(99) ///
        default(c(level)) ///
        option(level)

    TEXT tx_note1 15 350 555 ., ///
        label("Tip: click Draw to run the command and keep this dialog open")

    TEXT tx_note2 15 375 555 ., ///
        label("Use Plot options and Graph options tabs for appearance settings")

END


DIALOG plots, tabtitle("Plot options")
BEGIN

    TEXT tx_head0 15 15 40 ., ///
        label("Score")

    TEXT tx_head1 70 15 150 ., ///
        label("Fitted line options")

    TEXT tx_head2 245 15 150 ., ///
        label("CI options")

    TEXT tx_head3 420 15 160 ., ///
        label("Observed risk options")

    TEXT tx_s1 25 50 30 ., label("1")
    EDIT plot1 70 47 150 ., label("Plot 1 options") option(plot1opts)
    EDIT ci1 245 47 150 ., label("CI 1 options") option(ci1opts)
    EDIT sc1 420 47 160 ., label("Scatter 1 options") option(scatter1opts)

    TEXT tx_s2 25 90 30 ., label("2")
    EDIT plot2 70 87 150 ., label("Plot 2 options") option(plot2opts)
    EDIT ci2 245 87 150 ., label("CI 2 options") option(ci2opts)
    EDIT sc2 420 87 160 ., label("Scatter 2 options") option(scatter2opts)

    TEXT tx_s3 25 130 30 ., label("3")
    EDIT plot3 70 127 150 ., label("Plot 3 options") option(plot3opts)
    EDIT ci3 245 127 150 ., label("CI 3 options") option(ci3opts)
    EDIT sc3 420 127 160 ., label("Scatter 3 options") option(scatter3opts)

    TEXT tx_s4 25 170 30 ., label("4")
    EDIT plot4 70 167 150 ., label("Plot 4 options") option(plot4opts)
    EDIT ci4 245 167 150 ., label("CI 4 options") option(ci4opts)
    EDIT sc4 420 167 160 ., label("Scatter 4 options") option(scatter4opts)

    TEXT tx_s5 25 210 30 ., label("5")
    EDIT plot5 70 207 150 ., label("Plot 5 options") option(plot5opts)
    EDIT ci5 245 207 150 ., label("CI 5 options") option(ci5opts)
    EDIT sc5 420 207 160 ., label("Scatter 5 options") option(scatter5opts)

    TEXT tx_ex1 15 270 565 ., ///
        label("Examples: lpattern(dash)   lwidth(thin)   msize(small)   msymbol(O)")

    TEXT tx_ex2 15 300 565 ., ///
        label("These are passed directly to line, rcap, and scatter for each score")

END


DIALOG graph, tabtitle("Graph options")
BEGIN

    TEXT tx_graph 15 15 560 ., ///
        label("Additional twoway graph options:")

    EDIT graphopts 15 40 555 ., ///
        label("Graph options")

    TEXT tx_gex1 15 85 560 ., ///
        label("Example: title(Risk calibration plot) xtitle(Score) ytitle(Risk)")

    TEXT tx_gex2 15 115 560 ., ///
        label("Example: scheme(s1color) graphregion(color(white))")

    TEXT tx_gnote 15 165 560 ., ///
        label("Options entered here are passed through the command's * option")

END


OK ok1, label("OK")
SUBMIT draw1, label("Draw")
COPY copy1, label("Copy command")
CANCEL cancel1, label("Cancel")
RESET reset1


PROGRAM command
BEGIN

    require main.endpoint main.scores main.model

    put "riskcalplot "
    varlist main.endpoint main.scores

    beginoptions

        optionarg /asis main.model
        optionarg /asis main.marker

        option main.noci
        option main.nostat

        if ! main.level.isdefault() {
            optionarg main.level
        }

        optionarg /asis plots.plot1
        optionarg /asis plots.plot2
        optionarg /asis plots.plot3
        optionarg /asis plots.plot4
        optionarg /asis plots.plot5

        optionarg /asis plots.ci1
        optionarg /asis plots.ci2
        optionarg /asis plots.ci3
        optionarg /asis plots.ci4
        optionarg /asis plots.ci5

        optionarg /asis plots.sc1
        optionarg /asis plots.sc2
        optionarg /asis plots.sc3
        optionarg /asis plots.sc4
        optionarg /asis plots.sc5

        put graph.graphopts

    endoptions

END
