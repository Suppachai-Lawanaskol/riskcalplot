/* =========================
   Titles
   ========================= */

DIALOG titles, tabtitle("Titles")
BEGIN

    GROUPBOX gt_title 10 10 795 115, label("Title")

    TEXT tt_text 25 35 80 ., label("Text:")
    EDIT title 85 32 700 ., label("Title")

    TEXT tt_size 25 70 70 ., label("Size:")
    COMBOBOX titlesize 85 67 110 ., dropdown contents(textsizes) ///
        default("") label("Title size")

    TEXT tt_color 215 70 70 ., label("Color:")
    COMBOBOX titlecolor 275 67 100 ., dropdown contents(colors) ///
        default("") label("Title color")

    TEXT tt_pos 395 70 80 ., label("Position:")
    COMBOBOX titlepos 465 67 90 ., dropdown contents(clockpos) ///
        default("") label("Title position")

    TEXT tt_ring 575 70 60 ., label("Ring:")
    COMBOBOX titlering 625 67 70 ., dropdown contents(rings) ///
        default("") label("Title ring")

    CHECKBOX titlespan 710 70 75 ., label("Span") option(span)


    GROUPBOX gt_sub 10 140 795 95, label("Subtitle")

    TEXT ts_text 25 165 80 ., label("Text:")
    EDIT subtitle 85 162 700 ., label("Subtitle")

    TEXT ts_size 25 200 70 ., label("Size:")
    COMBOBOX subtitlesize 85 197 110 ., dropdown contents(textsizes) ///
        default("") label("Subtitle size")

    TEXT ts_color 215 200 70 ., label("Color:")
    COMBOBOX subtitlecolor 275 197 100 ., dropdown contents(colors) ///
        default("") label("Subtitle color")


    GROUPBOX gt_note 10 250 795 95, label("Note")

    TEXT tn_text 25 275 80 ., label("Text:")
    EDIT note 85 272 700 ., label("Note")

    TEXT tn_size 25 310 70 ., label("Size:")
    COMBOBOX notesize 85 307 110 ., dropdown contents(textsizes) ///
        default("") label("Note size")

    TEXT tn_color 215 310 70 ., label("Color:")
    COMBOBOX notecolor 275 307 100 ., dropdown contents(colors) ///
        default("") label("Note color")


    GROUPBOX gt_cap 10 360 795 95, label("Caption")

    TEXT tc_text 25 385 80 ., label("Text:")
    EDIT caption 85 382 700 ., label("Caption")

    TEXT tc_size 25 420 70 ., label("Size:")
    COMBOBOX captionsize 85 417 110 ., dropdown contents(textsizes) ///
        default("") label("Caption size")

    TEXT tc_color 215 420 70 ., label("Color:")
    COMBOBOX captioncolor 275 417 100 ., dropdown contents(colors) ///
        default("") label("Caption color")

END


/* =========================
   Legend
   ========================= */

DIALOG legend, tabtitle("Legend")
BEGIN

    GROUPBOX gl_main 10 10 795 125, label("Legend layout")

    CHECKBOX nolegend 25 35 180 ., label("Suppress legend") option(off)

    TEXT tl_cols 225 35 80 ., label("Columns:")
    COMBOBOX cols 295 32 80 ., dropdownlist contents(legend_cols) ///
        default(1) label("Legend columns")

    TEXT tl_rows 395 35 70 ., label("Rows:")
    EDIT rows 455 32 70 ., label("Legend rows") numonly

    TEXT tl_pos 545 35 70 ., label("Position:")
    COMBOBOX pos 610 32 80 ., dropdownlist contents(legend_pos) ///
        default(11) label("Legend position")

    TEXT tl_ring 705 35 50 ., label("Ring:")
    COMBOBOX ring 750 32 45 ., dropdownlist contents(rings) ///
        default(0) label("Legend ring")

    TEXT tl_size 25 75 80 ., label("Text size:")
    COMBOBOX size 95 72 100 ., dropdown contents(textsizes) ///
        default("") label("Legend size")

    TEXT tl_order 225 75 80 ., label("Order:")
    EDIT order 285 72 250 ., label("Legend order")

    CHECKBOX forcesize 555 75 160 ., label("Force key size") option(forcesize)


    GROUPBOX gl_region 10 150 795 130, label("Legend region")

    TEXT tl_fcolor 25 175 80 ., label("Fill:")
    COMBOBOX fcolor 85 172 110 ., dropdown contents(colors) ///
        default("") label("Legend fill color")

    TEXT tl_lcolor 215 175 80 ., label("Line:")
    COMBOBOX lcolor 275 172 100 ., dropdown contents(colors) ///
        default("") label("Legend line color")

    TEXT tl_lwidth 395 175 80 ., label("Width:")
    COMBOBOX lwidth 455 172 90 ., dropdown contents(linewidths) ///
        default("") label("Legend line width")

    TEXT tl_margin 565 175 80 ., label("Margin:")
    EDIT margin 625 172 160 ., label("Legend margin")

    TEXT tl_keyx 25 215 90 ., label("Key x size:")
    EDIT keyxsize 95 212 100 ., label("Legend key x size")

    TEXT tl_keyy 215 215 90 ., label("Key y size:")
    EDIT keyysize 285 212 100 ., label("Legend key y size")

    TEXT tl_symx 405 215 110 ., label("Symbol x size:")
    EDIT symxsize 495 212 100 ., label("Legend symbol x size")

    TEXT tl_colgap 615 215 90 ., label("Col gap:")
    EDIT colgap 685 212 100 ., label("Legend column gap")


    GROUPBOX gl_labels 10 295 795 125, label("Key labels")

    TEXT tl_l1 25 320 90 ., label("Key 1:")
    EDIT label1 85 317 300 ., label("Legend label 1")

    TEXT tl_l2 420 320 90 ., label("Key 2:")
    EDIT label2 480 317 300 ., label("Legend label 2")

    TEXT tl_l3 25 355 90 ., label("Key 3:")
    EDIT label3 85 352 300 ., label("Legend label 3")

    TEXT tl_l4 420 355 90 ., label("Key 4:")
    EDIT label4 480 352 300 ., label("Legend label 4")

END


/* =========================
   Graph region
   ========================= */

DIALOG graphreg, tabtitle("Graph region")
BEGIN

    GROUPBOX gg_style 10 10 795 185, label("Graph region style")

    TEXT tg_fcolor 25 40 100 ., label("Fill color:")
    COMBOBOX fcolor 105 37 130 ., dropdown contents(colors) ///
        default("") label("Graph fill color")

    TEXT tg_lcolor 265 40 100 ., label("Line color:")
    COMBOBOX lcolor 345 37 130 ., dropdown contents(colors) ///
        default("") label("Graph line color")

    TEXT tg_lwidth 505 40 90 ., label("Line width:")
    COMBOBOX lwidth 585 37 110 ., dropdown contents(linewidths) ///
        default("") label("Graph line width")

    TEXT tg_lpat 25 80 100 ., label("Line pattern:")
    COMBOBOX lpattern 105 77 130 ., dropdown contents(linepatterns) ///
        default("") label("Graph line pattern")

    TEXT tg_margin 265 80 100 ., label("Margin:")
    EDIT margin 345 77 180 ., label("Graph region margin")

    TEXT tg_icolor 555 80 100 ., label("Intensity:")
    COMBOBOX intensity 625 77 120 ., dropdown contents(intensity) ///
        default("") label("Graph intensity")

    TEXT tg_extra 25 125 150 ., label("Other region options:")
    EDIT extra 155 122 590 ., label("Other graph region options")


    GROUPBOX gg_size 10 215 795 150, label("Graph size and scheme")

    TEXT tg_scheme 25 245 90 ., label("Scheme:")
    EDIT scheme 95 242 200 ., label("Scheme") option(scheme)

    TEXT tg_xsize 330 245 80 ., label("xsize:")
    EDIT xsize 390 242 80 ., label("Graph xsize") numonly

    TEXT tg_ysize 500 245 80 ., label("ysize:")
    EDIT ysize 560 242 80 ., label("Graph ysize") numonly

    TEXT tg_aspect 665 245 90 ., label("Aspect:")
    EDIT aspect 720 242 65 ., label("Aspect ratio") numonly

    CHECKBOX nodraw 25 290 130 ., label("No draw") option(nodraw)

    TEXT tg_name 180 290 90 ., label("Name:")
    EDIT name 240 287 200 ., label("Graph name")

    CHECKBOX replace 465 290 130 ., label("Replace") option(replace)

END


