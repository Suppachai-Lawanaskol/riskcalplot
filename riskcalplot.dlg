    TEXT tx_tmargin 215 125 90 ., label("Margin:")
    EDIT xtitlemargin 305 122 70 ., label("X title margin")


    GROUPBOX gx_labels 410 10 395 260, label("Labels and ticks")

    TEXT tx_rule 425 35 165 ., label("Label rule / values:")
    EDIT xlabel 425 55 360 ., label("X labels")

    TEXT tx_lsize 425 90 90 ., label("Size:")
    COMBOBOX xlabelsize 515 87 110 ., dropdown contents(textsizes) default("") label("X label size")

    TEXT tx_lcolor 640 90 90 ., label("Color:")
    COMBOBOX xlabelcolor 700 87 85 ., dropdown contents(colors) default("") label("X label color")

    TEXT tx_langle 425 125 90 ., label("Angle:")
    EDIT xlabelangle 515 122 80 ., label("X label angle") numonly

    TEXT tx_format 615 125 90 ., label("Format:")
    EDIT xlabelformat 700 122 85 ., label("X label format")

    CHECKBOX xgrid 425 160 120 ., label("Grid") option(grid)
    CHECKBOX xnogrid 555 160 130 ., label("No grid") option(nogrid)

    TEXT tx_tick 425 195 150 ., label("Major ticks:")
    EDIT xtick 545 192 240 ., label("X ticks")

    TEXT tx_mtick 425 230 150 ., label("Minor ticks:")
    EDIT xmtick 545 227 240 ., label("X minor ticks")


    GROUPBOX gx_scale 10 180 385 230, label("Scale")

    TEXT tx_range 25 205 110 ., label("Range:")
    EDIT xrange 115 202 250 ., label("X scale range")

    CHECKBOX xlog 25 240 100 ., label("Log") option(log)
    CHECKBOX xreverse 135 240 120 ., label("Reverse") option(reverse)
    CHECKBOX xalt 265 240 100 ., label("Alternate") option(alt)

    CHECKBOX xoff 25 275 100 ., label("Off") option(off)
    CHECKBOX xnoline 135 275 140 ., label("No axis line") option(noline)

    TEXT tx_scaleextra 25 325 160 ., label("Other scale options:")
    EDIT xscaleextra 165 322 200 ., label("Other X scale options")


    GROUPBOX gx_ref 410 285 395 125, label("Reference line")

    TEXT tx_refval 425 310 110 ., label("Value(s):")
    EDIT xline 515 307 270 ., label("X reference line")

    TEXT tx_refcolor 425 345 80 ., label("Color:")
    COMBOBOX xlinecolor 485 342 90 ., dropdown contents(colors) default("") label("X line color")

    TEXT tx_refwidth 585 345 80 ., label("Width:")
    COMBOBOX xlinewidth 640 342 70 ., dropdown contents(linewidths) default("") label("X line width")

    TEXT tx_refpat 720 345 65 ., label("Pattern:")
    COMBOBOX xlinepattern 720 367 65 ., dropdown contents(linepatterns) default("") label("X line pattern")

END


/* =========================
   Titles
   ========================= */

DIALOG titles, tabtitle("Titles")
BEGIN

    GROUPBOX gt_title 10 10 795 105, label("Title")

    TEXT tt_text 25 35 80 ., label("Text:")
    EDIT title 85 32 700 ., label("Title")

    TEXT tt_size 25 70 70 ., label("Size:")
    COMBOBOX titlesize 85 67 110 ., dropdown contents(textsizes) default("") label("Title size")

    TEXT tt_color 215 70 70 ., label("Color:")
    COMBOBOX titlecolor 275 67 100 ., dropdown contents(colors) default("") label("Title color")

    TEXT tt_pos 395 70 80 ., label("Position:")
    COMBOBOX titlepos 465 67 90 ., dropdown contents(clockpos) default("") label("Title position")

    TEXT tt_ring 575 70 60 ., label("Ring:")
    COMBOBOX titlering 625 67 70 ., dropdown contents(rings) default("") label("Title ring")

    CHECKBOX titlespan 710 70 75 ., label("Span") option(span)


    GROUPBOX gt_sub 10 130 795 90, label("Subtitle")

    TEXT ts_text 25 155 80 ., label("Text:")
    EDIT subtitle 85 152 700 ., label("Subtitle")

    TEXT ts_size 25 190 70 ., label("Size:")
    COMBOBOX subtitlesize 85 187 110 ., dropdown contents(textsizes) default("") label("Subtitle size")

    TEXT ts_color 215 190 70 ., label("Color:")
    COMBOBOX subtitlecolor 275 187 100 ., dropdown contents(colors) default("") label("Subtitle color")


    GROUPBOX gt_cap 10 235 795 90, label("Caption")

    TEXT tc_text 25 260 80 ., label("Text:")
    EDIT caption 85 257 700 ., label("Caption")

    TEXT tc_size 25 295 70 ., label("Size:")
    COMBOBOX captionsize 85 292 110 ., dropdown contents(textsizes) default("") label("Caption size")

    TEXT tc_color 215 295 70 ., label("Color:")
    COMBOBOX captioncolor 275 292 100 ., dropdown contents(colors) default("") label("Caption color")


    GROUPBOX gt_note 10 340 795 105, label("Note")

    TEXT tn_text 25 365 80 ., label("Text:")
    EDIT note 85 362 700 ., label("Note")

    TEXT tn_size 25 400 70 ., label("Size:")
    COMBOBOX notesize 85 397 110 ., dropdown contents(textsizes) default("") label("Note size")

    TEXT tn_color 215 400 70 ., label("Color:")
    COMBOBOX notecolor 275 397 100 ., dropdown contents(colors) default("") label("Note color")

    TEXT tn_warn 405 400 380 ., ///
        label("riskcalplot already uses note() for performance statistics")

END


/* =========================
   Legend
   ========================= */

DIALOG legend, tabtitle("Legend")
BEGIN

    GROUPBOX gl_main 10 10 795 130, label("Legend layout")

    CHECKBOX nolegend 25 35 180 ., label("Suppress legend") option(off)

    TEXT tl_cols 225 35 80 ., label("Columns:")
    COMBOBOX cols 295 32 80 ., dropdownlist contents(legend_cols) default(1) label("Legend columns")

    TEXT tl_rows 395 35 70 ., label("Rows:")
    EDIT rows 455 32 70 ., label("Legend rows") numonly

    TEXT tl_pos 545 35 70 ., label("Position:")
    COMBOBOX pos 610 32 80 ., dropdownlist contents(legend_pos) default(11) label("Legend position")

    TEXT tl_ring 705 35 50 ., label("Ring:")
    COMBOBOX ring 750 32 45 ., dropdownlist contents(rings) default(0) label("Legend ring")

    TEXT tl_size 25 75 80 ., label("Text size:")
    COMBOBOX size 95 72 100 ., dropdown contents(textsizes) default("") label("Legend size")

    CHECKBOX forcesize 225 75 160 ., label("Force key size") option(forcesize)

    TEXT tl_order 405 75 80 ., label("Order:")
    EDIT order 465 72 320 ., label("Legend order")


    GROUPBOX gl_region 10 160 795 130, label("Legend region")

    TEXT tl_fcolor 25 185 80 ., label("Fill:")
    COMBOBOX fcolor 85 182 110 ., dropdown contents(colors) default("") label("Legend fill color")

    TEXT tl_lcolor 215 185 80 ., label("Line:")
    COMBOBOX lcolor 275 182 100 ., dropdown contents(colors) default("") label("Legend line color")

    TEXT tl_lwidth 395 185 80 ., label("Width:")
    COMBOBOX lwidth 455 182 90 ., dropdown contents(linewidths) default("") label("Legend line width")

    TEXT tl_margin 565 185 80 ., label("Margin:")
    EDIT margin 625 182 160 ., label("Legend margin")

    TEXT tl_keyx 25 225 90 ., label("Key x size:")
    EDIT keyxsize 95 222 100 ., label("Legend key x size")

    TEXT tl_keyy 215 225 90 ., label("Key y size:")
    EDIT keyysize 285 222 100 ., label("Legend key y size")

    TEXT tl_symx 405 225 110 ., label("Symbol x size:")
    EDIT symxsize 495 222 100 ., label("Legend symbol x size")

    TEXT tl_colgap 615 225 90 ., label("Col gap:")
    EDIT colgap 685 222 100 ., label("Legend column gap")


    GROUPBOX gl_adv 10 310 795 105, label("Advanced")

    TEXT tl_extra 25 340 150 ., label("Other legend options:")
    EDIT extra 165 337 620 ., label("Other legend options")

    TEXT tl_note 25 380 760 ., ///
        label("order() is advanced because riskcalplot creates plot indices dynamically")

END


/* =========================
   Overall
   ========================= */

DIALOG overall, tabtitle("Overall")
BEGIN

    GROUPBOX gor_graph 10 10 390 180, label("Graph region")

    TEXT og_fcolor 25 40 90 ., label("Fill:")
    COMBOBOX graphfcolor 90 37 115 ., dropdown contents(colors) default("") label("Graph fill")

    TEXT og_lcolor 220 40 90 ., label("Outline:")
    COMBOBOX graphlcolor 285 37 95 ., dropdown contents(colors) default("") label("Graph outline")

    TEXT og_lwidth 25 80 90 ., label("Width:")
    COMBOBOX graphlwidth 90 77 115 ., dropdown contents(linewidths) default("") label("Graph outline width")

    TEXT og_lpat 220 80 90 ., label("Pattern:")
    COMBOBOX graphlpattern 285 77 95 ., dropdown contents(linepatterns) default("") label("Graph outline pattern")

    TEXT og_margin 25 120 90 ., label("Margin:")
    EDIT graphmargin 90 117 290 ., label("Graph region margin")

    TEXT og_gextra 25 155 120 ., label("Other options:")
    EDIT graphextra 125 152 255 ., label("Other graph region options")


    GROUPBOX gor_plot 415 10 390 180, label("Plot region")

    TEXT op_fcolor 430 40 90 ., label("Fill:")
    COMBOBOX plotfcolor 495 37 115 ., dropdown contents(colors) default("") label("Plot fill")

    TEXT op_lcolor 625 40 90 ., label("Outline:")
    COMBOBOX plotlcolor 690 37 95 ., dropdown contents(colors) default("") label("Plot outline")

    TEXT op_lwidth 430 80 90 ., label("Width:")
    COMBOBOX plotlwidth 495 77 115 ., dropdown contents(linewidths) default("") label("Plot outline width")

    TEXT op_lpat 625 80 90 ., label("Pattern:")
    COMBOBOX plotlpattern 690 77 95 ., dropdown contents(linepatterns) default("") label("Plot outline pattern")

    TEXT op_margin 430 120 90 ., label("Margin:")
    EDIT plotmargin 495 117 290 ., label("Plot region margin")

    TEXT op_pextra 430 155 120 ., label("Other options:")
    EDIT plotextra 530 152 255 ., label("Other plot region options")


    GROUPBOX gor_size 10 210 795 115, label("Graph size and style")

    TEXT os_scheme 25 240 70 ., label("Scheme:")
    EDIT scheme 85 237 170 ., label("Scheme")

    TEXT os_xsize 280 240 60 ., label("xsize:")
    EDIT xsize 325 237 70 ., label("xsize") numonly

    TEXT os_ysize 420 240 60 ., label("ysize:")
    EDIT ysize 465 237 70 ., label("ysize") numonly

    TEXT os_aspect 560 240 80 ., label("Aspect:")
    EDIT aspect 620 237 70 ., label("Aspect ratio") numonly

    CHECKBOX nodraw 710 237 80 ., label("No draw") option(nodraw)


    GROUPBOX gor_output 10 345 795 125, label("Graph management")

    TEXT oo_name 25 375 60 ., label("Name:")
    EDIT name 80 372 210 ., label("Graph name")

    CHECKBOX namereplace 305 375 110 ., label("Replace") option(replace)

    TEXT oo_save 430 375 60 ., label("Saving:")
    EDIT saving 485 372 210 ., label("Saving filename")

    CHECKBOX savereplace 710 375 90 ., label("Replace") option(replace)

    TEXT oo_play 25 415 60 ., label("Play:")
    EDIT play 80 412 210 ., label("Graph editor recording")

    TEXT oo_extra 430 415 100 ., label("Other options:")
    EDIT extra 515 412 270 ., label("Additional twoway options")

END


/* =========================
   Buttons
   ========================= */

OK ok1, label("OK")
SUBMIT sub1, label("Draw")
COPY copy1, label("Copy command")
CANCEL can1, label("Cancel")
HELP hlp1, view("help riskcalplot")
RESET res1


/* =========================
   Layout-test command
   Main and if/in are functional.
   Graphics controls will be wired after layout approval.
   ========================= */

PROGRAM command
BEGIN

    require main.endpoint main.scores main.model

    if ifin.inlast & !ifin.infirst {
        require ifin.infirst
    }

    put "riskcalplot "
    varlist main.endpoint main.scores

    ifexp ifin.ifexp

    if ifin.infirst {
        put " in " ifin.infirst
        if ifin.inlast {
            put "/" ifin.inlast
        }
        put " "
    }

    beginoptions

        optionarg /asis main.model
        optionarg /asis observed.marker

        option main.noci
        option main.nostat

        if ! main.level.isdefault() {
            optionarg main.level
        }

    endoptions

END
