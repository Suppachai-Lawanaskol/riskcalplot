/* =========================
   Output / advanced
   ========================= */

DIALOG output, tabtitle("Output")
BEGIN

    GROUPBOX go_save 10 10 795 135, label("Graph output")

    TEXT tos_save 25 40 90 ., label("Saving:")
    EDIT saving 95 37 420 ., label("Graph saving filename")

    CHECKBOX savereplace 535 40 150 ., label("Replace file") option(replace)

    TEXT tos_play 25 80 90 ., label("Graph editor:")
    EDIT play 95 77 420 ., label("Graph editor recording")

    TEXT tos_extra 25 180 760 ., ///
        label("Residual options not represented above (optional):")

    EDIT extra 25 205 760 ., label("Additional twoway options")

    TEXT tos_note 25 250 760 ., ///
        label("Most common twoway appearance options are now structured; this field is only a fallback")

END


/* =========================
   Buttons
   ========================= */

OK ok1, label("OK")
SUBMIT sub1, label("Draw")
COPY copy1, label("Copy command")
CANCEL can1, label("Cancel")
HELP hlp1, view("help riskcalplot")
RESET res1


/* =========================
   Command construction
   ========================= */

PROGRAM command
BEGIN

    require main.endpoint main.scores main.model

    put "riskcalplot "
    varlist main.endpoint main.scores

    beginoptions

        /* ----- riskcalplot-specific ----- */
        optionarg /asis main.model
        optionarg /asis main.marker
        option main.noci
        option main.nostat

        if ! main.level.isdefault() {
            optionarg main.level
        }


        /* ----- Y title ----- */
        if yaxis.ytitle {
            put " ytitle("
            put `"""'
            put yaxis.ytitle
            put `"""'
            if yaxis.ytitlesize {
                put ", size(" yaxis.ytitlesize ")"
            }
            if yaxis.ytitlecolor {
                put " color(" yaxis.ytitlecolor ")"
            }
            if yaxis.ytitleangle {
                put " angle(" yaxis.ytitleangle ")"
            }
            if yaxis.ytitlemargin {
                put " margin(" yaxis.ytitlemargin ")"
            }
            put ") "
        }

        /* ----- Y labels ----- */
        if yaxis.ylabel | yaxis.ylabelsize | yaxis.ylabelcolor | yaxis.ylabelangle | ///
           yaxis.ylabelformat | yaxis.ygrid | yaxis.ynogrid {
            put " ylabel("
            if yaxis.ylabel {
                put yaxis.ylabel
            }
            put ","
            if yaxis.ylabelsize {
                put " labsize(" yaxis.ylabelsize ")"
            }
            if yaxis.ylabelcolor {
                put " labcolor(" yaxis.ylabelcolor ")"
            }
            if yaxis.ylabelangle {
                put " angle(" yaxis.ylabelangle ")"
            }
            if yaxis.ylabelformat {
                put " format(" yaxis.ylabelformat ")"
            }
            if yaxis.ygrid {
                put " grid"
            }
            if yaxis.ynogrid {
                put " nogrid"
            }
            put ") "
        }

        if yaxis.ytick {
            put " ytick(" yaxis.ytick ") "
        }
        if yaxis.ymtick {
            put " ymtick(" yaxis.ymtick ") "
        }

        /* ----- Y scale ----- */
        if yaxis.yrange | yaxis.ylog | yaxis.yreverse | yaxis.yalt | ///
           yaxis.yoff | yaxis.ynoline | yaxis.yscaleextra {
            put " yscale("
            if yaxis.yrange {
                put "range(" yaxis.yrange ") "
            }
            if yaxis.ylog {
                put "log "
            }
            if yaxis.yreverse {
                put "reverse "
            }
            if yaxis.yalt {
                put "alt "
            }
            if yaxis.yoff {
                put "off "
            }
            if yaxis.ynoline {
                put "noline "
            }
            if yaxis.yscaleextra {
                put yaxis.yscaleextra
            }
            put ") "
        }

        /* ----- Y reference line ----- */
        if yaxis.yline {
            put " yline(" yaxis.yline
            if yaxis.ylinecolor | yaxis.ylinewidth | yaxis.ylinepattern {
                put ","
                if yaxis.ylinecolor {
                    put " lcolor(" yaxis.ylinecolor ")"
                }
                if yaxis.ylinewidth {
                    put " lwidth(" yaxis.ylinewidth ")"
                }
                if yaxis.ylinepattern {
                    put " lpattern(" yaxis.ylinepattern ")"
                }
            }
            put ") "
        }


        /* ----- X title ----- */
        if xaxis.xtitle {
            put " xtitle("
            put `"""'
            put xaxis.xtitle
            put `"""'
            if xaxis.xtitlesize {
                put ", size(" xaxis.xtitlesize ")"
            }
            if xaxis.xtitlecolor {
                put " color(" xaxis.xtitlecolor ")"
            }
            if xaxis.xtitleangle {
                put " angle(" xaxis.xtitleangle ")"
            }
            if xaxis.xtitlemargin {
                put " margin(" xaxis.xtitlemargin ")"
            }
            put ") "
        }

        /* ----- X labels ----- */
        if xaxis.xlabel | xaxis.xlabelsize | xaxis.xlabelcolor | xaxis.xlabelangle | ///
           xaxis.xlabelformat | xaxis.xgrid | xaxis.xnogrid {
            put " xlabel("
            if xaxis.xlabel {
                put xaxis.xlabel
            }
            put ","
            if xaxis.xlabelsize {
                put " labsize(" xaxis.xlabelsize ")"
            }
            if xaxis.xlabelcolor {
                put " labcolor(" xaxis.xlabelcolor ")"
            }
            if xaxis.xlabelangle {
                put " angle(" xaxis.xlabelangle ")"
            }
            if xaxis.xlabelformat {
                put " format(" xaxis.xlabelformat ")"
            }
            if xaxis.xgrid {
                put " grid"
            }
            if xaxis.xnogrid {
                put " nogrid"
            }
            put ") "
        }

        if xaxis.xtick {
            put " xtick(" xaxis.xtick ") "
        }
        if xaxis.xmtick {
            put " xmtick(" xaxis.xmtick ") "
        }

        /* ----- X scale ----- */
        if xaxis.xrange | xaxis.xlog | xaxis.xreverse | xaxis.xalt | ///
           xaxis.xoff | xaxis.xnoline | xaxis.xscaleextra {
            put " xscale("
            if xaxis.xrange {
                put "range(" xaxis.xrange ") "
            }
            if xaxis.xlog {
                put "log "
            }
            if xaxis.xreverse {
                put "reverse "
            }
            if xaxis.xalt {
                put "alt "
            }
            if xaxis.xoff {
                put "off "
            }
            if xaxis.xnoline {
                put "noline "
            }
            if xaxis.xscaleextra {
                put xaxis.xscaleextra
            }
            put ") "
        }

        /* ----- X reference line ----- */
        if xaxis.xline {
            put " xline(" xaxis.xline
            if xaxis.xlinecolor | xaxis.xlinewidth | xaxis.xlinepattern {
                put ","
                if xaxis.xlinecolor {
                    put " lcolor(" xaxis.xlinecolor ")"
                }
                if xaxis.xlinewidth {
                    put " lwidth(" xaxis.xlinewidth ")"
                }
                if xaxis.xlinepattern {
                    put " lpattern(" xaxis.xlinepattern ")"
                }
            }
            put ") "
        }


        /* ----- Main title ----- */
        if titles.title {
            put " title("
            put `"""'
            put titles.title
            put `"""'
            if titles.titlesize | titles.titlecolor | titles.titlepos | ///
               titles.titlering | titles.titlespan {
                put ","
                if titles.titlesize {
                    put " size(" titles.titlesize ")"
                }
                if titles.titlecolor {
                    put " color(" titles.titlecolor ")"
                }
                if titles.titlepos {
                    put " position(" titles.titlepos ")"
                }
                if titles.titlering {
                    put " ring(" titles.titlering ")"
                }
                if titles.titlespan {
                    put " span"
                }
            }
            put ") "
        }

        if titles.subtitle {
            put " subtitle("
            put `"""'
            put titles.subtitle
            put `"""'
            if titles.subtitlesize | titles.subtitlecolor {
                put ","
                if titles.subtitlesize {
                    put " size(" titles.subtitlesize ")"
                }
                if titles.subtitlecolor {
                    put " color(" titles.subtitlecolor ")"
                }
            }
            put ") "
        }

        if titles.note {
            put " note("
            put `"""'
            put titles.note
            put `"""'
            if titles.notesize | titles.notecolor {
                put ","
                if titles.notesize {
                    put " size(" titles.notesize ")"
                }
                if titles.notecolor {
                    put " color(" titles.notecolor ")"
                }
            }
            put ") "
        }

        if titles.caption {
            put " caption("
            put `"""'
            put titles.caption
            put `"""'
            if titles.captionsize | titles.captioncolor {
                put ","
                if titles.captionsize {
                    put " size(" titles.captionsize ")"
                }
                if titles.captioncolor {
                    put " color(" titles.captioncolor ")"
                }
            }
            put ") "
        }


        /* ----- Legend ----- */
        if legend.nolegend {
            put " legend(off) "
        }
        else {
            put " legend("
            if legend.cols {
                put " cols(" legend.cols ")"
            }
            if legend.rows {
                put " rows(" legend.rows ")"
            }
            if legend.pos {
                put " position(" legend.pos ")"
            }
            if legend.ring {
                put " ring(" legend.ring ")"
            }
            if legend.size {
                put " size(" legend.size ")"
            }
            if legend.order {
                put " order(" legend.order ")"
            }
            if legend.forcesize {
                put " forcesize"
            }
            if legend.fcolor | legend.lcolor | legend.lwidth | legend.margin {
                put " region("
                if legend.fcolor {
                    put " fcolor(" legend.fcolor ")"
                }
                if legend.lcolor {
                    put " lcolor(" legend.lcolor ")"
                }
                if legend.lwidth {
                    put " lwidth(" legend.lwidth ")"
                }
                if legend.margin {
                    put " margin(" legend.margin ")"
                }
                put ")"
            }
            if legend.keyxsize {
                put " keyxsize(" legend.keyxsize ")"
            }
            if legend.keyysize {
                put " keyysize(" legend.keyysize ")"
            }
            if legend.symxsize {
                put " symxsize(" legend.symxsize ")"
            }
            if legend.colgap {
                put " colgap(" legend.colgap ")"
            }
            if legend.label1 {
                put " label(1 "
                put `"""'
                put legend.label1
                put `"""'
                put ")"
            }
            if legend.label2 {
                put " label(2 "
                put `"""'
                put legend.label2
                put `"""'
                put ")"
            }
            if legend.label3 {
                put " label(3 "
                put `"""'
                put legend.label3
                put `"""'
                put ")"
            }
            if legend.label4 {
                put " label(4 "
                put `"""'
                put legend.label4
                put `"""'
                put ")"
            }
            put ") "
        }


        /* ----- Graph region ----- */
        if graphreg.fcolor | graphreg.lcolor | graphreg.lwidth | graphreg.lpattern | ///
           graphreg.margin | graphreg.intensity | graphreg.extra {
            put " graphregion("
            if graphreg.fcolor {
                put " fcolor(" graphreg.fcolor ")"
            }
            if graphreg.lcolor {
                put " lcolor(" graphreg.lcolor ")"
            }
            if graphreg.lwidth {
                put " lwidth(" graphreg.lwidth ")"
            }
            if graphreg.lpattern {
                put " lpattern(" graphreg.lpattern ")"
            }
            if graphreg.margin {
                put " margin(" graphreg.margin ")"
            }
            if graphreg.intensity {
                put " intensity(" graphreg.intensity ")"
            }
            if graphreg.extra {
                put " " graphreg.extra
            }
            put ") "
        }

        optionarg /asis graphreg.scheme

        if graphreg.xsize {
            put " xsize(" graphreg.xsize ") "
        }
        if graphreg.ysize {
            put " ysize(" graphreg.ysize ") "
        }
        if graphreg.aspect {
            put " aspectratio(" graphreg.aspect ") "
        }
        option graphreg.nodraw

        if graphreg.name {
            put " name(" graphreg.name
            if graphreg.replace {
                put ", replace"
            }
            put ") "
        }


        /* ----- Plot region ----- */
        if plotreg.fcolor | plotreg.lcolor | plotreg.lwidth | plotreg.lpattern | ///
           plotreg.margin | plotreg.intensity | plotreg.extra {
            put " plotregion("
            if plotreg.fcolor {
                put " fcolor(" plotreg.fcolor ")"
            }
            if plotreg.lcolor {
                put " lcolor(" plotreg.lcolor ")"
            }
            if plotreg.lwidth {
                put " lwidth(" plotreg.lwidth ")"
            }
            if plotreg.lpattern {
                put " lpattern(" plotreg.lpattern ")"
            }
            if plotreg.margin {
                put " margin(" plotreg.margin ")"
            }
            if plotreg.intensity {
                put " intensity(" plotreg.intensity ")"
            }
            if plotreg.extra {
                put " " plotreg.extra
            }
            put ") "
        }


        /* ----- Fitted lines ----- */
        if fitted.lc1 | fitted.lp1 | fitted.lw1 | fitted.lx1 {
            put " plot1opts("
            if fitted.lc1 {
                put " lcolor(" fitted.lc1 ")"
            }
            if fitted.lp1 {
                put " lpattern(" fitted.lp1 ")"
            }
            if fitted.lw1 {
                put " lwidth(" fitted.lw1 ")"
            }
            if fitted.lx1 {
                put " " fitted.lx1
            }
            put ") "
        }
        if fitted.lc2 | fitted.lp2 | fitted.lw2 | fitted.lx2 {
            put " plot2opts("
            if fitted.lc2 {
                put " lcolor(" fitted.lc2 ")"
            }
            if fitted.lp2 {
                put " lpattern(" fitted.lp2 ")"
            }
            if fitted.lw2 {
                put " lwidth(" fitted.lw2 ")"
            }
            if fitted.lx2 {
                put " " fitted.lx2
            }
            put ") "
        }
        if fitted.lc3 | fitted.lp3 | fitted.lw3 | fitted.lx3 {
            put " plot3opts("
            if fitted.lc3 {
                put " lcolor(" fitted.lc3 ")"
            }
            if fitted.lp3 {
                put " lpattern(" fitted.lp3 ")"
            }
            if fitted.lw3 {
                put " lwidth(" fitted.lw3 ")"
            }
            if fitted.lx3 {
                put " " fitted.lx3
            }
            put ") "
        }
        if fitted.lc4 | fitted.lp4 | fitted.lw4 | fitted.lx4 {
            put " plot4opts("
            if fitted.lc4 {
                put " lcolor(" fitted.lc4 ")"
            }
            if fitted.lp4 {
                put " lpattern(" fitted.lp4 ")"
            }
            if fitted.lw4 {
                put " lwidth(" fitted.lw4 ")"
            }
            if fitted.lx4 {
                put " " fitted.lx4
            }
            put ") "
        }
        if fitted.lc5 | fitted.lp5 | fitted.lw5 | fitted.lx5 {
            put " plot5opts("
            if fitted.lc5 {
                put " lcolor(" fitted.lc5 ")"
            }
            if fitted.lp5 {
                put " lpattern(" fitted.lp5 ")"
            }
            if fitted.lw5 {
                put " lwidth(" fitted.lw5 ")"
            }
            if fitted.lx5 {
                put " " fitted.lx5
            }
            put ") "
        }


        /* ----- Observed points ----- */
        if observed.ms1 | observed.mz1 | observed.mf1 | observed.ml1 | observed.mx1 {
            put " scatter1opts("
            if observed.ms1 {
                put " msymbol(" observed.ms1 ")"
            }
            if observed.mz1 {
                put " msize(" observed.mz1 ")"
            }
            if observed.mf1 {
                put " mfcolor(" observed.mf1 ")"
            }
            if observed.ml1 {
                put " mlcolor(" observed.ml1 ")"
            }
            if observed.mx1 {
                put " " observed.mx1
            }
            put ") "
        }
        if observed.ms2 | observed.mz2 | observed.mf2 | observed.ml2 | observed.mx2 {
            put " scatter2opts("
            if observed.ms2 {
                put " msymbol(" observed.ms2 ")"
            }
            if observed.mz2 {
                put " msize(" observed.mz2 ")"
            }
            if observed.mf2 {
                put " mfcolor(" observed.mf2 ")"
            }
            if observed.ml2 {
                put " mlcolor(" observed.ml2 ")"
            }
            if observed.mx2 {
                put " " observed.mx2
            }
            put ") "
        }
        if observed.ms3 | observed.mz3 | observed.mf3 | observed.ml3 | observed.mx3 {
            put " scatter3opts("
            if observed.ms3 {
                put " msymbol(" observed.ms3 ")"
            }
            if observed.mz3 {
                put " msize(" observed.mz3 ")"
            }
            if observed.mf3 {
                put " mfcolor(" observed.mf3 ")"
            }
            if observed.ml3 {
                put " mlcolor(" observed.ml3 ")"
            }
            if observed.mx3 {
                put " " observed.mx3
            }
            put ") "
        }
        if observed.ms4 | observed.mz4 | observed.mf4 | observed.ml4 | observed.mx4 {
            put " scatter4opts("
            if observed.ms4 {
                put " msymbol(" observed.ms4 ")"
            }
            if observed.mz4 {
                put " msize(" observed.mz4 ")"
            }
            if observed.mf4 {
                put " mfcolor(" observed.mf4 ")"
            }
            if observed.ml4 {
                put " mlcolor(" observed.ml4 ")"
            }
            if observed.mx4 {
                put " " observed.mx4
            }
            put ") "
        }
        if observed.ms5 | observed.mz5 | observed.mf5 | observed.ml5 | observed.mx5 {
            put " scatter5opts("
            if observed.ms5 {
                put " msymbol(" observed.ms5 ")"
            }
            if observed.mz5 {
                put " msize(" observed.mz5 ")"
            }
            if observed.mf5 {
                put " mfcolor(" observed.mf5 ")"
            }
            if observed.ml5 {
                put " mlcolor(" observed.ml5 ")"
            }
            if observed.mx5 {
                put " " observed.mx5
            }
            put ") "
        }


        /* ----- CI lines ----- */
        if ci.cc1 | ci.cp1 | ci.cw1 | ci.cx1 {
            put " ci1opts("
            if ci.cc1 {
                put " lcolor(" ci.cc1 ")"
            }
            if ci.cp1 {
                put " lpattern(" ci.cp1 ")"
            }
            if ci.cw1 {
                put " lwidth(" ci.cw1 ")"
            }
            if ci.cx1 {
                put " " ci.cx1
            }
            put ") "
        }
        if ci.cc2 | ci.cp2 | ci.cw2 | ci.cx2 {
            put " ci2opts("
            if ci.cc2 {
                put " lcolor(" ci.cc2 ")"
            }
            if ci.cp2 {
                put " lpattern(" ci.cp2 ")"
            }
            if ci.cw2 {
                put " lwidth(" ci.cw2 ")"
            }
            if ci.cx2 {
                put " " ci.cx2
            }
            put ") "
        }
        if ci.cc3 | ci.cp3 | ci.cw3 | ci.cx3 {
            put " ci3opts("
            if ci.cc3 {
                put " lcolor(" ci.cc3 ")"
            }
            if ci.cp3 {
                put " lpattern(" ci.cp3 ")"
            }
            if ci.cw3 {
                put " lwidth(" ci.cw3 ")"
            }
            if ci.cx3 {
                put " " ci.cx3
            }
            put ") "
        }
        if ci.cc4 | ci.cp4 | ci.cw4 | ci.cx4 {
            put " ci4opts("
            if ci.cc4 {
                put " lcolor(" ci.cc4 ")"
            }
            if ci.cp4 {
                put " lpattern(" ci.cp4 ")"
            }
            if ci.cw4 {
                put " lwidth(" ci.cw4 ")"
            }
            if ci.cx4 {
                put " " ci.cx4
            }
            put ") "
        }
        if ci.cc5 | ci.cp5 | ci.cw5 | ci.cx5 {
            put " ci5opts("
            if ci.cc5 {
                put " lcolor(" ci.cc5 ")"
            }
            if ci.cp5 {
                put " lpattern(" ci.cp5 ")"
            }
            if ci.cw5 {
                put " lwidth(" ci.cw5 ")"
            }
            if ci.cx5 {
                put " " ci.cx5
            }
            put ") "
        }


        /* ----- Output ----- */
        if output.saving {
            put " saving("
            put `"""'
            put output.saving
            put `"""'
            if output.savereplace {
                put ", replace"
            }
            put ") "
        }

        if output.play {
            put " play("
            put `"""'
            put output.play
            put `"""'
            put ") "
        }

        if output.extra {
            put output.extra
        }

    endoptions

END
